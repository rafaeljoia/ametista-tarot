# Database
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=ametista
DB_PASSWORD=ametista123
DB_NAME=ametista_tarot

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Environment
NODE_ENV=development
PORT=3001

# Frontend URL (used by CORS and e-mail links)
FRONTEND_URL=http://localhost:3000

# ===== Mercado Pago =====
# Painel: https://www.mercadopago.com.br/developers/panel/app
# Use credenciais TEST-... em desenvolvimento e APP_USR-... em produção.
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MP_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000
# Segredo do webhook (Webhooks > "Configurar notificações" > Assinatura secreta).
# Quando ausente, o webhook aceita sem validar assinatura (apenas para dev).
MP_WEBHOOK_SECRET=

# ===== SMTP (e-mails transacionais — opcional) =====
# Quando vazio, e-mails de confirmação são gravados em log em vez de enviados.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Ametista Tarot <no-reply@ametista.braviaglobal.com.br>
